#:import app kivy.app.App

MDScreen:
    name: "transactions"
    md_bg_color: 0.94, 0.99, 0.98, 1
    
    MDBoxLayout:
        orientation: "vertical"
        
        # App Bar with Search
        MDTopAppBar:
            title: "Transactions"
            elevation: 0
            specific_text_color: 0.08, 0.72, 0.65, 1
            md_bg_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.root.current = "dashboard"]]
            
            MDTextField:
                id: search_field
                hint_text: "Search..."
                mode: "rectangle"
                size_hint_x: 0.6
                pos_hint: {"center_x": 0.5}
                icon_left: "magnify"
                on_text: app.root.get_screen("transactions").on_search_text(*args)
        
        # Filter Chips
        MDBoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(16, 8)
            spacing: dp(8)
            
            MDFillRoundFlatButton:
                text: "All"
                size_hint_x: None
                width: dp(70)
                md_bg_color: 0.08, 0.72, 0.65, 1 if app.root.get_screen("transactions").filter_type == "all" else 0.8, 0.8, 0.8, 1
                on_release: 
                    app.root.get_screen("transactions").set_filter("all")
            
            MDFillRoundFlatButton:
                text: "Income"
                size_hint_x: None
                width: dp(80)
                md_bg_color: 0.08, 0.72, 0.65, 1 if app.root.get_screen("transactions").filter_type == "income" else 0.8, 0.8, 0.8, 1
                on_release: 
                    app.root.get_screen("transactions").set_filter("income")
            
            MDFillRoundFlatButton:
                text: "Expenses"
                size_hint_x: None
                width: dp(80)
                md_bg_color: 0.08, 0.72, 0.65, 1 if app.root.get_screen("transactions").filter_type == "expense" else 0.8, 0.8, 0.8, 1
                on_release: 
                    app.root.get_screen("transactions").set_filter("expense")
        
        # Transactions List
        ScrollView:
            do_scroll_x: False
            
            MDBoxLayout:
                id: transactions_container
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(16)
                spacing: dp(8)
                
                MDLabel:
                    text: "No transactions found"
                    halign: "center"
                    theme_text_color: "Hint"
                    size_hint_y: None
                    height: dp(100)
        
        # FAB for adding transaction
        MDFloatingActionButton:
            icon: "plus"
            pos_hint: {"right": 0.95, "bottom": 0.95}
            md_bg_color: 0.08, 0.72, 0.65, 1
            elevation: 4
            on_release: app.root.current = "add_transaction"
        
        # Bottom Navigation
        MDBottomNavigation:
            panel_color: 1, 1, 1, 1
            elevation: 8
            
            MDBottomNavigationItem:
                name: "nav_dashboard"
                text: "Home"
                icon: "home-outline"
                on_tab_press: app.root.current = "dashboard"
            
            MDBottomNavigationItem:
                name: "nav_transactions"
                text: "Transactions"
                icon: "swap-horizontal"
                active: True
                on_tab_press: app.root.current = "transactions"
            
            MDBottomNavigationItem:
                name: "nav_analytics"
                text: "Analytics"
                icon: "chart-pie"
                on_tab_press: app.root.current = "analytics"
            
            MDBottomNavigationItem:
                name: "nav_accounts"
                text: "Accounts"
                icon: "wallet"
                on_tab_press: app.root.current = "accounts"
            
            MDBottomNavigationItem:
                name: "nav_settings"
                text: "Settings"
                icon: "cog-outline"
                on_tab_press: app.root.current = "settings"
